# Copy to backend/.env and fill in. Never commit the real file.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_PROJECT_REF=YOUR-PROJECT
# Postgres connection string (Supabase pooler). Leave empty to use a local SQLite file.
RD_DB_URL=
# Comma separated emails that get admin / officer rights on first sign in
RD_ADMIN_EMAILS=
RD_OFFICER_EMAILS=
# Public address of the API (used in links and voice agent webhooks)
RD_PUBLIC_URL=http://localhost:8000

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM=
